# Copy this file to .env and fill it in. .env is never committed - see .gitignore.

# From @BotFather in Telegram: /newbot, then copy the token it gives you.
TELEGRAM_TOKEN=

# The chat that receives new orders and the morning summary.
# Easiest way to find it: message @userinfobot in Telegram, it replies with your id.
OWNER_CHAT_ID=

# Hour of the day (0-23, server time) when the night summary is sent.
SUMMARY_HOUR=7

# Where orders are kept. Any path relative to the project root. Empty = storage/orders.json.
ORDERS_FILE=

# ── WhatsApp channel (whatsapp/server.js) — WhatsApp Cloud API by Meta, the business's own Meta app
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# The owner's WhatsApp number for order alerts (free text works only within 24 h of the owner's last message; otherwise an approved template)
WA_OWNER=
PORT=3000
